# --- Railway variables ---

# Your LiveAvatar API key (ROTATE the one you pasted in chat, use the new one here)
LIVEAVATAR_API_KEY=

# The avatar you chose in LiveAvatar (a UUID, from your LiveAvatar dashboard)
LIVEAVATAR_AVATAR_ID=

# Returned by `npm run register-secret` (the one-time setup step)
LIVEAVATAR_SECRET_ID=

# Your ElevenLabs agent (defaults to Iris if omitted)
ELEVENLABS_AGENT_ID=agent_4301kq7pcrscezmrvnegnz2sqp95

# Only needed when running register-secret.js (needs convai_read, user_read, voices_read)
ELEVENLABS_API_KEY=

# Comma-separated origins allowed to call the API (your live + staging domains)
ALLOWED_ORIGIN=https://your-site.com,https://your-site.webflow.io
